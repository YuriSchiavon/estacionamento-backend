# Copie este arquivo para ".env" e preencha quando for para produção.
# Sem essa variável definida, o sistema usa SQLite local (estacionamento.db) --
# ótimo para testar, mas não recomendado para produção.

# Postgres (ex: Railway, Supabase, Neon, RDS):
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/nome_do_banco

# MySQL (ex: PlanetScale, RDS):
# DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/nome_do_banco

# Chaves de API dos totens -- cada totem físico usa a sua, enviada no header
# "X-API-Key" em toda requisição. Sem elas definidas aqui, o sistema usa
# valores padrão de desenvolvimento (o servidor avisa no log quando isso
# acontece). Gere valores longos e aleatórios antes de ir para produção,
# um por totem -- ex: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_ENTRADA=dev-entrada-troque-em-producao
API_KEY_VALIDACAO=dev-validacao-troque-em-producao
API_KEY_SAIDA=dev-saida-troque-em-producao

# Chave do painel de gestão (cadastro de credenciados/mensalistas e
# relatórios) -- NÃO configure essa chave em nenhum totem.
API_KEY_GESTAO=dev-gestao-troque-em-producao
