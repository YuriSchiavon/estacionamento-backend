<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Visibilidade de pacote (Android 11+), necessária pra
         TotemActivity.garantirScannerComoTecladoAtivo() conseguir
         consultar o estado do app de sistema "Scanner como teclado" do
         SK210. Sem isso, PackageManager.getApplicationEnabledSetting()
         lança NameNotFoundException mesmo com o pacote instalado. -->
    <queries>
        <package android:name="com.android.scanneraskeyboard" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyParkTotem"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TotemActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>
