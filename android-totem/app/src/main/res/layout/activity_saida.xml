<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Passo 1: apresentar/digitar o ticket -->
    <ScrollView
        android:id="@+id/pagina_ticket"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_leitor"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apresente o ticket"
                android:textColor="@color/texto_claro"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Aproxime o ticket do leitor ou digite o código"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp"
                android:gravity="center" />

            <EditText
                android:id="@+id/campo_ticket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_totem"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="CÓDIGO DO TICKET"
                android:textColorHint="@color/texto_secundario"
                android:textColor="@color/texto_claro"
                android:textSize="22sp"
                android:letterSpacing="0.08"
                android:padding="20dp"
                android:maxLines="1"
                android:inputType="textVisiblePassword"
                android:imeOptions="actionDone" />

            <Button
                android:id="@+id/btn_verificar_ticket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="22dp"
                android:text="VERIFICAR"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:background="@drawable/bg_botao_lime" />

            <TextView
                android:id="@+id/erro_ticket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_resultado_err"
                android:padding="16dp"
                android:textColor="@color/danger_claro"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Passo 2: resultado da verificação -->
    <ScrollView
        android:id="@+id/pagina_resultado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <LinearLayout
                android:id="@+id/caixa_resultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_resultado_ok"
                android:padding="28dp">

                <TextView
                    android:id="@+id/resultado_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:textColor="@color/ok_claro"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Motivo"
                        android:textColor="@color/texto_secundario" />
                    <TextView
                        android:id="@+id/resultado_motivo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/texto_claro"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linha_permanencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Permanência"
                        android:textColor="@color/texto_secundario" />
                    <TextView
                        android:id="@+id/resultado_permanencia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/texto_claro"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linha_valor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Valor a pagar"
                        android:textColor="@color/texto_secundario" />
                    <TextView
                        android:id="@+id/resultado_valor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/texto_claro"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acoes_fallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_ir_pagamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="22dp"
                    android:text="Pagar"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:background="@drawable/bg_botao_lime" />

                <Button
                    android:id="@+id/btn_ir_validar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="20dp"
                    android:text="Validar Cupom"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/lime"
                    android:background="@drawable/bg_botao_contorno" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_novo_ticket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="14dp"
                android:text="Concluir"
                android:textColor="@color/texto_secundario"
                android:background="@drawable/bg_botao_secundario" />

        </LinearLayout>
    </ScrollView>

    <!-- Passo 3: validar cupom fiscal -->
    <ScrollView
        android:id="@+id/pagina_validar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_leitor"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Validar cupom"
                android:textColor="@color/texto_claro"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Aproxime o QR code da nota fiscal do leitor"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp"
                android:gravity="center" />

            <EditText
                android:id="@+id/campo_qr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_totem"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="AGUARDANDO LEITURA"
                android:textColorHint="@color/texto_secundario"
                android:textColor="@color/texto_claro"
                android:textSize="16sp"
                android:padding="20dp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/erro_validar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_resultado_err"
                android:padding="16dp"
                android:textColor="@color/danger_claro"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/valor_manual_wrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Não conseguimos ler o valor da compra automaticamente. Digite o valor impresso no cupom:"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp"
                    android:gravity="center" />

                <EditText
                    android:id="@+id/campo_valor_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_totem"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="0,00"
                    android:textColorHint="@color/texto_secundario"
                    android:textColor="@color/texto_claro"
                    android:textSize="22sp"
                    android:padding="20dp"
                    android:maxLines="1"
                    android:inputType="numberDecimal" />

                <Button
                    android:id="@+id/btn_confirmar_valor_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="20dp"
                    android:text="Confirmar"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:background="@drawable/bg_botao_lime" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_voltar_validar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="14dp"
                android:text="voltar"
                android:textColor="@color/texto_secundario"
                android:background="@drawable/bg_botao_secundario" />

        </LinearLayout>
    </ScrollView>

    <!-- Passo 4: forma de pagamento -->
    <ScrollView
        android:id="@+id/pagina_pagamento"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:id="@+id/pagamento_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor a pagar"
                android:textColor="@color/texto_claro"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Toque na forma de pagamento"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_forma_pix"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_lime"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_pix"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="PIX"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_forma_credito"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_lime"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_credito"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Crédito"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_forma_debito"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_lime"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_debito"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Débito"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/erro_pagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_resultado_err"
                android:padding="16dp"
                android:textColor="@color/danger_claro"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_voltar_pagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="14dp"
                android:text="voltar"
                android:textColor="@color/texto_secundario"
                android:background="@drawable/bg_botao_secundario" />

        </LinearLayout>
    </ScrollView>

    <!-- Passo 5: aguardando pagamento PIX -->
    <ScrollView
        android:id="@+id/pagina_pix"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pague com PIX"
                android:textColor="@color/texto_claro"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pix_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:textColor="@color/lime"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/pix_qr_imagem"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@android:color/white"
                android:padding="12dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/pix_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Aguardando pagamento..."
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/erro_pix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_resultado_err"
                android:padding="16dp"
                android:textColor="@color/danger_claro"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_cancelar_pix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:padding="14dp"
                android:text="cancelar e escolher outra forma"
                android:textColor="@color/texto_secundario"
                android:background="@drawable/bg_botao_secundario" />

        </LinearLayout>
    </ScrollView>

    <!-- Área invisível: 5 toques em até 3s saem do modo quiosque e voltam
         pra tela de escolha (mesmo gesto de TotemActivity). -->
    <View
        android:id="@+id/area_saida_quiosque"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start" />

</FrameLayout>
